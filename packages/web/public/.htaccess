# Site GLE — configuration Apache pour l'hébergement mutualisé.

Options -Indexes
DirectoryIndex index.html

# Le fichier de configuration du formulaire ne doit jamais être servi.
<Files "contact-config.php">
  Require all denied
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forcer HTTPS (à activer une fois le certificat SSL installé).
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Application monopage : toute URL qui n'est ni un fichier ni un dossier
  # réel est confiée à index.html, qui affiche la bonne page.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # La page d'audit interne reste accessible mais n'est pas indexée.
  <If "%{REQUEST_URI} =~ m#^/audit#">
    Header set X-Robots-Tag "noindex, nofollow"
  </If>

  # Les fichiers de /assets portent un hash dans leur nom : cache d'un an.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # index.html doit toujours être revalidé pour récupérer les nouvelles versions.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType text/vtt "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/vtt application/javascript application/json image/svg+xml
</IfModule>

AddType text/vtt .vtt
AddType video/mp4 .mp4
